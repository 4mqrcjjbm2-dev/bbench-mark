# Copie ce fichier en .env puis remplis-le (l'installateur le fait pour toi).

# Moteur IA : "ollama" = libre et gratuit (par défaut) ; "anthropic" = Claude (clé payante).
AGENT_FOURNISSEUR=ollama
# Modèle Ollama. Exemples : qwen3:8b (8 Go de RAM), qwen3:14b (16 Go), qwen3:32b ou gpt-oss:20b (carte graphique),
# ou un modèle cloud gratuit d'Ollama (liste : https://ollama.com/search?c=cloud), après « ollama signin ».
# Vide = l'installateur choisit selon la mémoire de la machine (4b, 8b ou 14b).
AGENT_MODEL=
# Modèle plus léger pour Caro et les spécialistes (moins de tokens, moins d'énergie). Vide = le même.
AGENT_MODELE_LEGER=qwen3:4b
# Modèle RENFORT (optionnel) : gros modèle cloud d'Ollama pour les grosses créations, après « ollama signin ».
# Payant en crédits selon ton abonnement Ollama ; jamais utilisé hors ligne ni par Caro. Vide = pas de renfort.
# Exemple : AGENT_MODELE_RENFORT=kimi-k3:cloud
AGENT_MODELE_RENFORT=
# Messages gardés en contexte avec Ollama : moins = plus rapide et moins énergivore.
AGENT_HISTORIQUE_MAX=24
OLLAMA_URL=http://localhost:11434
# Recherche web libre (SearXNG). Vide = DuckDuckGo seulement.
SEARXNG_URL=
# Wikipédia hors ligne (Kiwix) : rempli par deploy/telecharger-savoir.sh. Hors Docker : http://localhost:8080
KIWIX_URL=
# Mode hors ligne : auto (détecte Internet), 1 (toujours hors ligne), 0 (toujours en ligne)
AGENT_HORS_LIGNE=auto
# Dossier où Jarvis crée ses fichiers
AGENT_ATELIER=~/Jarvis
# Seulement si AGENT_FOURNISSEUR=anthropic : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Jeton secret que le Raccourci iPhone enverra (24 caractères minimum).
# Génère-le avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=
# Facultatif
AGENT_EFFORT=low
AGENT_TIMEZONE=Europe/Paris
AGENT_SESSION_TTL_HOURS=6
AGENT_ENABLE_WEB=1
AGENT_FALLBACKS=1

# Mémoire du Cerveau : chemin vers ta copie locale du dépôt cerveaux-
# (git clone https://github.com/<toi>/cerveaux-). Jarvis lit la doctrine, le profil
# et les leçons, et écrit journal / leçons / prédictions puis fait commit + push.
AGENT_CERVEAU_DIR=
# 0 = commit local seulement (pas de push vers GitHub)
AGENT_CERVEAU_PUSH=1
