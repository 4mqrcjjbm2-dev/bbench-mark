# Démarrage automatique sur un serveur Linux (VPS).
# Remplace CHEMIN et UTILISATEUR, copie dans /etc/systemd/system/ puis :
#   sudo systemctl enable --now agent-personnel
[Unit]
Description=Agent personnel Claude
After=network-online.target

[Service]
User=UTILISATEUR
ExecStart=/bin/bash CHEMIN/deploy/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
